FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       iputils-ping \
       traceroute \
       mtr-tiny \
       dnsutils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV NETWORK_MCP_HOST=0.0.0.0

# The FastAPI app mounts the MCP streamable-HTTP endpoint at /mcp, so one
# Render service can expose the public API and MCP tools without two servers
# competing for the same PORT.
CMD ["sh", "-c", "uvicorn app.backend.route:router --host 0.0.0.0 --port ${PORT:-10000}"]
