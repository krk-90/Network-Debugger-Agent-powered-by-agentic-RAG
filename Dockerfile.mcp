# ---------- Frontend build ----------
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend
COPY app/frontend/package.json ./
RUN npm install
COPY app/frontend/ ./
RUN npm run build

# ---------- Backend + frontend runtime ----------
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       iputils-ping \
       traceroute \
       mtr-tiny \
       dnsutils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Copy the compiled React application into the location served by FastAPI.
COPY --from=frontend-builder /frontend/dist /app/app/frontend/dist

ENV PYTHONUNBUFFERED=1
ENV NETWORK_MCP_HOST=0.0.0.0

# One Render service exposes the React UI, FastAPI API, and MCP endpoint.
CMD ["sh", "-c", "uvicorn app.backend.route:router --host 0.0.0.0 --port ${PORT:-10000}"]
